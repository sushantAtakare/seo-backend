PORT=7000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/seo_automation?schema=public"

JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_NAME=SEO Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Enable only for local fixture/testing. Never enable in production.
CRAWLER_ALLOW_PRIVATE_NETWORKS=false

# External SEO integrations
USE_MOCKS=true
INTEGRATION_TIMEOUT_MS=15000
PAGESPEED_API_KEY=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
